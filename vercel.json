{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "crons": [
    { "path": "/api/subscription/generate-bill", "schedule": "0 2 1 * *" },
    { "path": "/api/subscription/enforce-overdue", "schedule": "0 3 * * *" }
  ]
}
